@* GIF-like form demo: cross-fades the start and end position photos of an exercise. *@
@if (ImageUrls is { Count: > 0 } urls)
{
    <div class="ex-anim @Class" style="@Style" role="img" aria-label="@($"{Alt} – form demonstration")">
        <img src="@urls[0]" alt="" loading="lazy" />
        @if (urls.Count > 1)
        {
            <img src="@urls[1]" alt="" loading="lazy" class="frame-b" />
        }
    </div>
}
else
{
    <div class="ex-anim placeholder @Class" style="@Style">
        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" />
    </div>
}

@code {
    [Parameter] public IReadOnlyList<string>? ImageUrls { get; set; }
    [Parameter] public string Alt { get; set; } = "Exercise";
    [Parameter] public string? Class { get; set; }

    /// <summary>Square box size in pixels (ignored when <see cref="Fill"/> is set).</summary>
    [Parameter] public int Size { get; set; } = 64;

    /// <summary>Fill the parent's width with the photos' 3:2 aspect ratio.</summary>
    [Parameter] public bool Fill { get; set; }

    private string Style => Fill ? "width:100%;aspect-ratio:3/2;" : $"width:{Size}px;height:{Size}px;";
}
